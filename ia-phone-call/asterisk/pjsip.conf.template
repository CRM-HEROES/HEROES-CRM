; ==============================================================================
; CONFIGURATION PJSIP KAVKOM — base statique + agents IA dynamiques
; NE PAS MODIFIER CE FICHIER DIRECTEMENT, modifier pjsip.conf.template
; ==============================================================================

; --- 0. Paramètres globaux ---
; IMPORTANT : le SBC de Kavkom abandonne silencieusement (aucune réponse)
; toute requête SIP dont l'en-tête User-Agent contient "Asterisk".
[global]
type=global
user_agent=${KAVKOM_USER_AGENT}

; --- 1. Transports disponibles pour les endpoints agents IA ---
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_signaling_address=${KAVKOM_EXTERNAL_ADDRESS}
external_media_address=${KAVKOM_EXTERNAL_ADDRESS}

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_signaling_address=${KAVKOM_EXTERNAL_ADDRESS}
external_media_address=${KAVKOM_EXTERNAL_ADDRESS}

[transport-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
external_signaling_address=${KAVKOM_EXTERNAL_ADDRESS}
external_media_address=${KAVKOM_EXTERNAL_ADDRESS}
cert_file=/etc/asterisk/keys/asterisk.pem
ca_list_file=/etc/asterisk/keys/ca.pem
method=tlsv1_2
verify_server=yes
allow_wildcard_certs=yes

; --- 2. Endpoints SIP générés par ia-phone-call pour chaque agent IA ---
#include dynamic/ai-agents.conf
