; ==============================================================================
; CONFIGURATION TRUNK SIP KAVKOM — généré automatiquement depuis .env
; NE PAS MODIFIER CE FICHIER DIRECTEMENT, modifier pjsip.conf.template
; ==============================================================================

; --- 0. Paramètres globaux ---
; IMPORTANT : le SBC de Kavkom abandonne silencieusement (aucune réponse)
; toute requête SIP dont l'en-tête User-Agent contient "Asterisk". Le défaut
; d'Asterisk ("Asterisk PBX 22.x") provoque donc un statut "Rejected" sur
; l'enregistrement et peut faire échouer les INVITE sortants.
[global]
type=global
user_agent=${KAVKOM_USER_AGENT}

; --- 1. Transport (UDP ou TLS selon KAVKOM_SIP_TRANSPORT) ---
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_signaling_address=${KAVKOM_EXTERNAL_ADDRESS}
external_media_address=${KAVKOM_EXTERNAL_ADDRESS}

[transport-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
external_signaling_address=${KAVKOM_EXTERNAL_ADDRESS}
external_media_address=${KAVKOM_EXTERNAL_ADDRESS}
cert_file=/etc/asterisk/keys/asterisk.pem
ca_list_file=/etc/asterisk/keys/ca.pem
method=tlsv1_2
verify_server=yes
allow_wildcard_certs=yes

; --- 2. Enregistrement auprès de Kavkom ---
[kavkom-reg]
type=registration
outbound_auth=kavkom-auth
transport=transport-${KAVKOM_SIP_TRANSPORT}
server_uri=sip:${KAVKOM_USER_CONTEXT}:${KAVKOM_SIP_PORT}
client_uri=sip:${KAVKOM_EXTENSION}@${KAVKOM_USER_CONTEXT}
retry_interval=60
expiration=3600
user_agent=${KAVKOM_USER_AGENT}
contact_user=${KAVKOM_EXTENSION}
; Continuer à réessayer même après un rejet d'authentification : sans cela
; Asterisk abandonne définitivement et reste bloqué en "Rejected".
auth_rejection_permanent=no

; --- 3. Authentification ---
[kavkom-auth]
type=auth
auth_type=userpass
username=${KAVKOM_EXTENSION}
password=${KAVKOM_PASSWORD}
realm=${KAVKOM_USER_CONTEXT}

; --- 4. Endpoint ---
[kavkom-trunk]
type=endpoint
context=from-kavkom
transport=transport-${KAVKOM_SIP_TRANSPORT}
disallow=all
allow=alaw,ulaw
outbound_auth=kavkom-auth
aors=kavkom-aor
direct_media=no
; Identité présentée à Kavkom sur les appels sortants : le compte authentifié.
; Sans ces deux options, le From serait "sip:kavkom-trunk@..." et Kavkom
; refuse/bloque l'appel.
from_user=${KAVKOM_EXTENSION}
from_domain=${KAVKOM_USER_CONTEXT}

; --- 5. AOR ---
[kavkom-aor]
type=aor
contact=sip:${KAVKOM_USER_CONTEXT}:${KAVKOM_SIP_PORT}

; --- 6. Identification des appels entrants ---
[kavkom-identify]
type=identify
endpoint=kavkom-trunk
match=${KAVKOM_USER_CONTEXT}
