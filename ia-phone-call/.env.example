# ==============================================================================
#  ia-phone-call — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs manquantes
# ==============================================================================

# ── Serveur Node.js ────────────────────────────────────────────────────────────
# Port TCP sur lequel Asterisk envoie l'audio via AudioSocket
PORT=9701
# (Optionnel) Port exposé par Docker vers l'hôte — doit correspondre à AUDIOSOCKET_PORT
AUDIOSOCKET_PORT=9701

# ── Asterisk AudioSocket ────────────────────────────────────────────────────────
# UUID utilisé dans extensions.conf pour identifier le flux AudioSocket
# Doit correspondre exactement au 1er argument de AudioSocket() dans extensions.conf
AUDIOSOCKET_UUID=12345678-1234-1234-1234-123456789abc

# ── Kavkom / SIP ───────────────────────────────────────────────────────────────
# Domaine SIP Kavkom (ex: aria-madacom.kavkom.com)
KAVKOM_SIP_DOMAIN=

# Extension SIP enregistrée auprès de Kavkom (utilisée par Asterisk)
KAVKOM_EXTENSION=
# Mot de passe de l'extension SIP
KAVKOM_PASSWORD=
# Contexte SIP Kavkom
KAVKOM_USER_CONTEXT=
# Transport SIP (udp | tcp | tls)
KAVKOM_SIP_TRANSPORT=udp
# Port SIP selon le transport (5060 pour UDP/TCP, 5061 pour TLS)
KAVKOM_SIP_PORT=5060
# User-Agent SIP envoyé à Kavkom — DOIT rester neutre.
# Le SBC de Kavkom ignore silencieusement (aucune réponse => statut "Rejected")
# toute requête dont le User-Agent contient "Asterisk", donc ne jamais le
# laisser vide (Asterisk utiliserait alors "Asterisk PBX <version>").
KAVKOM_USER_AGENT=HeroesCRM-Phone/1.0

# ── Asterisk AMI (appels sortants) ─────────────────────────────────────────────
# Doivent correspondre au compte [default] de asterisk/manager.conf
ASTERISK_AMI_HOST=ia-asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=default
ASTERISK_AMI_SECRET=HeroesAmi2026!
# Endpoint PJSIP utilisé pour les appels sortants. Asterisk 21+ n'a plus chan_sip
# et l'AOR de Kavkom ne définit que le domaine : le canal est donc
# "PJSIP/<numero>@<endpoint>" et non "PJSIP/<endpoint>/<numero>".
ASTERISK_TRUNK_ENDPOINT=kavkom-trunk

# ── Gemini Live API ────────────────────────────────────────────────────────────
# Clé API Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Modèle Gemini Live à utiliser
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_API_VERSION=v1alpha

# Modèle utilisé pour l'extraction des données post-appel
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash-lite

# ── Laravel CRM (webhook résultats d'appel) ────────────────────────────────────
# URL de base du CRM Laravel (sans slash final)
# En Docker local : http://host.docker.internal:8000
# En production   : https://votre-crm.example.com
LARAVEL_BASE_URL=http://host.docker.internal:8000

# Secret partagé entre le CRM et ce service (doit correspondre dans Laravel .env)
AI_PHONE_AGENT_SHARED_SECRET=

# ── Stockage des enregistrements ───────────────────────────────────────────────
# Chemin DANS le conteneur (volume Docker monté)
CALL_RECORDING_DIR=/data/calls

# ── Docker / Infrastructure ────────────────────────────────────────────────────
# Port SIP UDP exposé par le conteneur Asterisk vers l'hôte
SIP_PORT=5060

# Fuseau horaire du conteneur Asterisk
TZ=Europe/Paris

# ── Mode Test ──────────────────────────────────────────────────────────────────
# true = restreindre les appels aux numéros ci-dessous (tests locaux)
# false = production, aucune restriction
TEST_MODE=true
# Numéros autorisés en mode test (format E.164 sans +, séparés par des virgules)
TEST_ALLOWED_NUMBERS=33660000000
