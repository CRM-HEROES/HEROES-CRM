# Control API (Laravel -> this service) and FreeSWITCH audio (this service <- FreeSWITCH)
HTTP_PORT=4000
WS_PORT=4001
TRANSCRIPT_WS_PORT=4002
# Publicly reachable from FreeSWITCH's box, e.g. ws://10.0.0.5:4001/
WS_PUBLIC_URL=ws://127.0.0.1:4001/

# Must match AI_PHONE_AGENT_SHARED_SECRET in the Laravel .env
AI_PHONE_AGENT_SHARED_SECRET=

# Laravel base URL (no trailing slash), used to POST the call outcome
LARAVEL_BASE_URL=http://127.0.0.1:8000
CALL_RECORDING_DIR=/data/calls

# Gemini Live (server-to-server: the real API key, no ephemeral token needed)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_API_VERSION=v1alpha
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# FreeSWITCH ESL (Event Socket Library) control connection
FS_ESL_HOST=127.0.0.1
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon

# Dial-string prefixes used to reach Kavkom through FreeSWITCH's own SIP
# registration/gateway. Adjust to match your FreeSWITCH sofia profile or
# gateway name (see ai-phone-agent/README.md). The same gateway usually
# handles both internal extensions and external PSTN numbers for a single
# Kavkom tenant, so both default to the same prefix.
FS_DIAL_PREFIX_INTERNAL=sofia/gateway/kavkom/
FS_DIAL_PREFIX_EXTERNAL=sofia/gateway/kavkom/

# Conference room prefix and the loopback dialplan extension that hosts the
# AI tap (see freeswitch/dialplan-example.xml)
FS_CONFERENCE_PROFILE=ai-agent
FS_LOOPBACK_TARGET=loopback/ai-agent-tap/default

# Caller ID presented on the outbound leg to the prospect (your Kavkom DID)
FS_CALLER_ID_NUMBER=
FS_CALLER_ID_NAME=Heroes CRM

# Kavkom live call-state WebSocket. KAVKOM_REFRESH_ACCESS_TOKEN is a server
# secret; never expose it to the browser or commit it.
KAVKOM_LIVE_BASE_URL=https://live.kavkom.com
KAVKOM_REFRESH_ACCESS_TOKEN=
# Use these only if your Kavkom tenant provides a separate refresh-token endpoint.
KAVKOM_REFRESH_TOKEN_ENDPOINT=
KAVKOM_REFRESH_BEARER=
KAVKOM_USER_UUID=
KAVKOM_WS_EXTENSIONS=1001

# Safety switch for local tests. Use normalized digits, comma-separated.
TEST_MODE=true
TEST_ALLOWED_NUMBERS=
ORCHESTRATOR_HTTP_PORT=4010
VOICE_BRIDGE_URL=http://ai-phone-agent:4000
DASHBOARD_PORT=4100
TRANSCRIPT_PUBLIC_URL=ws://localhost:4002
